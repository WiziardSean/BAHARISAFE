# BahariSafe - Weather API settings (Issue #2)
# Copy this file to .env.local and adjust if needed:  cp .env.example .env.local
# NOTE: Vite exposes every VITE_* variable to the browser. Never put real secrets here.

# Open-Meteo forecast endpoint (free for non-commercial use, no API key needed)
VITE_OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# How long a forecast counts as "fresh" before we fetch again (minutes)
VITE_WEATHER_CACHE_TTL_MINUTES=10

# How long an old forecast may still be shown as a "saved forecast" when the API is down (hours)
VITE_WEATHER_STALE_MAX_HOURS=6

# Give up on a request after this many milliseconds
VITE_WEATHER_REQUEST_TIMEOUT_MS=8000

# Timezone used for hourly timestamps (East Africa Time)
VITE_WEATHER_TIMEZONE=Africa/Nairobi
